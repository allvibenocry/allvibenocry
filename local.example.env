# Local configuration for the tools in this repository (rule 10, D7).
#
# Copy this file to local.env, which is gitignored, and fill it in there. Never
# commit local.env: it holds details of your own machines. Every value below is
# a placeholder. Secrets never go in this file either; tools read those by name
# from the environment or from files with restricted permissions (rule 4).

# A real Debian 13 test host, reached over SSH with a key (BatchMode=yes, so a
# missing key fails instead of asking for a password). The user needs root, or
# sudo without a password. Leave it empty to use the local test host container.
# Example: ALLVIBE_TEST_HOST=admin@test-laptop.example
ALLVIBE_TEST_HOST=
